# ── Database ───────────────────────────────────────────────────────
# Neon Postgres connection string (auto-set by Vercel Neon integration)
DATABASE_URL=postgres://...

# ── Application ───────────────────────────────────────────────────
# Public HTTPS origin used in email links (REQUIRED in production)
APP_URL=https://your-domain.example

# IANA timezone used for business dates and reminders
APP_TIMEZONE=Asia/Karachi

# ── Auth ──────────────────────────────────────────────────────────
# Any long random string — used to sign session cookies (REQUIRED)
SESSION_SECRET=some-very-long-random-string-change-this

# ── Super Admin ────────────────────────────────────────────────────
# Created automatically on first run if no superadmin exists
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme123

# ── Email notifications (optional) ────────────────────────────────
# Sign up free at https://resend.com — verify a sending domain first
# If not set, all email notifications are skipped
RESEND_API_KEY=re_...
RESEND_FROM=CFT <billing@yourdomain.com>

# ── Cron job (optional) ────────────────────────────────────────────
# Protects the task and invoice reminder cron endpoints from public access
# Set this in Vercel — Vercel Cron sends it automatically as a Bearer token
# Without this set, the cron endpoint refuses to run (by design)
CRON_SECRET=some-random-secret-string

# How many days before due date to send reminders (default: 2)
TASK_REMINDER_WINDOW_DAYS=2
INVOICE_REMINDER_WINDOW_DAYS=2

# Maximum active tasks per team member (default: 1)
TASK_CAPACITY_PER_MEMBER=1
