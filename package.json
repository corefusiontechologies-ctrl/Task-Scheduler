{
  "name": "task-scheduler",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run db:migrate",
    "build": "next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
